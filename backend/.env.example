# Environment Configuration
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
PROJECT_NAME="Stitch & Style API"

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# PostgreSQL Database (psycopg 3 driver: postgresql+psycopg://user:password@host:port/dbname)
DATABASE_URL=postgresql+psycopg://stitch_admin:your_secure_password_here@127.0.0.1:5433/stitch_style_db

# Security & Authentication (Argon2id + PyJWT)
# Generate a secure 64-char hex secret using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_minimum_32_characters_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
